<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\lib\</BaseOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VL.Core" Version="$(VLVersion)" />
    <PackageReference Include="VL.Stride.Runtime" Version="$(VLVersion)" />
    <PackageReference Include="Stride.Graphics" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.Rendering" Version="$(StrideVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nurbsy\Nurbsy.csproj" />
    <ProjectReference Include="..\..\Nurbsy.Rendering\Nurbsy.Rendering.csproj" />
  </ItemGroup>
</Project>
